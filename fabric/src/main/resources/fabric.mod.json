{
	"schemaVersion": 1,
	"id": "secretblocks",
	"version": "${version}",

	"name": "Secret Blocks",
	"description": "Hidden blocks that look like the blocks around them.",
	"authors": [
		"CaliberMC"
	],
	"contact": {
		"homepage": "*",
		"sources": "https://github.com/calibergames/secret-blocks",
		"issues": "https://github.com/calibergames/secret-blocks/issues"
	},
	"license": "LGPL-3.0",
	"icon": "assets/secretblocks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.calibermc.secretblocks.fabric.SecretBlocksFabric"
		],
		"client": [
			"net.calibermc.secretblocks.SecretBlocksClient"
		],
		"preLaunch": [
			"net.calibermc.secretblocks.compat.RendererCheck"
		]
	},
	"accessWidener": "secretblocks.accesswidener",
	"mixins": [
		"secretblocks.mixins.json",
		"secretblocks.fabric.mixins.json"
	],
	"breaks": {
		"quilt_loader": "<0.30.2"
	},
	"depends": {
		"fabricloader": ">=${fabric_loader_min}",
		"fabric-api": ">=${fabric_api_min}",
		"minecraft": [${minecraft_versions}],
		"java": ">=21"
	}
}
